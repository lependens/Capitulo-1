{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aemet.example/schemas/aemet-raw-capture-v1.schema.json",
  "title": "AEMET Raw Municipal Forecast Capture",
  "type": "object",
  "required": [
    "schema_version", "collector_version", "run_id", "capture_id", "station",
    "municipality", "capture", "source", "valid_times_raw", "periods_raw",
    "payload_structure", "http", "artifacts", "errors"
  ],
  "properties": {
    "schema_version": {"const": "aemet-raw-capture-v1"},
    "collector_version": {"type": "string"},
    "run_id": {"type": "string", "pattern": "^run_"},
    "capture_id": {"type": "string", "pattern": "^cap_"},
    "station": {
      "type": "object", "required": ["code", "name"], "additionalProperties": false,
      "properties": {"code": {"type": "string"}, "name": {"type": "string"}}
    },
    "municipality": {
      "type": "object", "required": ["id", "name", "spatial_match"], "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "spatial_match": {"type": "string"}
      }
    },
    "capture": {
      "type": "object", "required": ["started_at_utc", "finished_at_utc", "status"], "additionalProperties": false,
      "properties": {
        "started_at_utc": {"type": "string", "format": "date-time"},
        "finished_at_utc": {"type": "string", "format": "date-time"},
        "status": {"enum": ["complete", "partial", "failed"]}
      }
    },
    "source": {
      "type": "object", "required": ["provider", "product", "issue_time_raw", "issue_timezone"], "additionalProperties": false,
      "properties": {
        "provider": {"const": "AEMET"},
        "product": {"const": "prediccion_municipio_diaria"},
        "issue_time_raw": {"type": ["string", "null"]},
        "issue_timezone": {"type": "null"}
      }
    },
    "valid_times_raw": {"type": "array", "items": {"type": "string"}},
    "periods_raw": {"type": "array", "items": {"type": "string"}},
    "payload_structure": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["format", "top_level_type", "top_level_count", "root_fields", "day_count", "field_names_by_day", "variables_observed", "json_null_count", "empty_string_count"],
          "properties": {
            "format": {"const": "JSON"},
            "top_level_type": {"type": "string"},
            "top_level_count": {"type": "integer", "minimum": 0},
            "root_fields": {"type": "array", "items": {"type": "string"}},
            "day_count": {"type": "integer", "minimum": 0},
            "field_names_by_day": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}},
            "variables_observed": {"type": "array", "items": {"type": "string"}},
            "json_null_count": {"type": "integer", "minimum": 0},
            "empty_string_count": {"type": "integer", "minimum": 0}
          }
        }
      ]
    },
    "http": {
      "type": "object", "required": ["wrapper", "payload"], "additionalProperties": false,
      "properties": {
        "wrapper": {"$ref": "#/$defs/httpRecordOrNull"},
        "payload": {"$ref": "#/$defs/httpRecordOrNull"}
      }
    },
    "artifacts": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "wrapper": {"$ref": "#/$defs/artifactRecord"},
        "payload": {"$ref": "#/$defs/artifactRecord"}
      }
    },
    "errors": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false,
  "$defs": {
    "httpRecordOrNull": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["method", "url", "url_redacted", "status_code", "content_type", "content_encoding", "charset", "fetched_at_utc", "byte_length", "sha256"],
          "properties": {
            "method": {"const": "GET"},
            "url": {"type": "string"},
            "url_redacted": {"type": "boolean"},
            "status_code": {"type": ["integer", "null"]},
            "content_type": {"type": ["string", "null"]},
            "content_encoding": {"type": "string"},
            "charset": {"type": ["string", "null"]},
            "fetched_at_utc": {"type": "string", "format": "date-time"},
            "byte_length": {"type": "integer", "minimum": 0},
            "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          }
        }
      ]
    },
    "artifactRecord": {
      "type": "object", "additionalProperties": false,
      "required": ["filename", "byte_length", "sha256"],
      "properties": {
        "filename": {"type": "string", "enum": ["wrapper.raw", "payload.raw"]},
        "byte_length": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
