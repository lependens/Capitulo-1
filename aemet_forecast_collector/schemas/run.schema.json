{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aemet.example/schemas/aemet-raw-run-v1.schema.json",
  "title": "AEMET Raw Capture Run",
  "type": "object",
  "required": ["schema_version", "collector_version", "run_id", "started_at_utc", "finished_at_utc", "status", "captures"],
  "properties": {
    "schema_version": {"const": "aemet-raw-run-v1"},
    "collector_version": {"type": "string"},
    "run_id": {"type": "string", "pattern": "^run_"},
    "started_at_utc": {"type": "string", "format": "date-time"},
    "finished_at_utc": {"type": "string", "format": "date-time"},
    "status": {"enum": ["complete", "partial", "failed"]},
    "captures": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["station_code", "capture_id", "status"],
        "properties": {
          "station_code": {"type": "string"},
          "capture_id": {"type": "string", "pattern": "^cap_"},
          "status": {"enum": ["complete", "partial", "failed"]}
        }
      }
    }
  },
  "additionalProperties": false
}
