# Credenciales SIAR (requeridas para consultar la API)
SIAR_NIF=
SIAR_PASSWORD=

# Token de GitHub con permiso de escritura en el repositorio sincronizado
GITHUB_TOKEN=

# Avisos de Telegram (opcionales; deben proporcionarse ambos)
TG_BOT_TOKEN=
TG_CHAT_ID=

# Parámetros de descarga y sincronización (valores predeterminados del código)
SIAR_CHUNK_DAYS=7
SIAR_PAUSE_SECONDS=3
SIAR_API_RETRIES=3
SIAR_PUSH_EVERY_CHUNKS=4
SIAR_TARGET_DATE=2025-12-31
SIAR_REFRESH_RECENT_DAYS=31

# Legacy/deprecada: app.py aún la lee por compatibilidad; la autenticación actual usa NIF/contraseña.
SIAR_API_KEY=

# Opcional. Vacío = TLS estándar.
# Para activar temporalmente el workaround de MAPA:
# SIAR_CA_BUNDLE=/app/certs/siar_bundle.pem
SIAR_CA_BUNDLE=
