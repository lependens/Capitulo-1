FROM node:22-alpine AS build
WORKDIR /app
COPY web_app/frontend/package*.json ./
RUN npm ci
COPY web_app/frontend/ ./
RUN npm run build
FROM nginx:alpine
COPY web_app/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
USER nginx
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s CMD wget -q -O /dev/null http://127.0.0.1:8080/api/health || exit 1
